# Local OpenAI-Compatible Model (Primary Local AI: LFM2.5-2.6B)
AI_BASE_URL="http://localhost:8080/v1"
AI_MODEL="LiquidAI/LFM2.5-2.6B-GGUF:Q4_K_M"
AI_API_KEY="local"

# GEMINI_API_KEY: Fallback cloud AI engine if local server is starting up.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
